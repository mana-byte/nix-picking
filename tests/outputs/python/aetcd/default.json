{
  "pname": "aetcd",
  "version": "1.0.0a4",
  "pyproject": true,
  "src": {
    "function": "fetchFromGitHub",
    "owner": "martyanov",
    "repo": "aetcd",
    "tag": "v${version}",
    "hash": "sha256-g49ppfh8dyGpZeu/HdTDX8RAk5VTcZmqENRpNY12qkg="
  },
  "--replace-fail \"setuptools_scm": [
    "=6.3.2\" \"setuptools_scm\"",
    "''"
  ],
  "pythonRelaxDeps": [
    "protobuf"
  ],
  "build-system": [
    "setuptools",
    "setuptools-scm"
  ],
  "dependencies": [
    "grpcio",
    "protobuf"
  ],
  "nativeCheckInputs": [
    "pytest-asyncio",
    "pytest-cov-stub",
    "pytest-mock",
    "pytestCheckHook"
  ],
  "pythonImportsCheck": [
    "aetcd"
  ],
  "disabledTestPaths": "tests/integration/",
  "meta": {
    "description": "Python asyncio-based client for etcd",
    "homepage": "https://github.com/martyanov/aetcd",
    "changelog": "https://github.com/martyanov/aetcd/blob/v${version}/docs/changelog.rst",
    "license": "lib.licenses.asl20",
    "maintainers": "with lib.maintainers; [ fab ]"
  }
}